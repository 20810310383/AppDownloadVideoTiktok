# npm install -g expo-cli eas-cli
# eas login
# eas logout
# eas init

# eas.json
# {
#   "cli": {
#     "version": ">= 3.0.0"
#   },
#   "build": {
#     "production": {
#       "android": {
#         "buildType": "apk"
#       }
#     }
#   }
# }
# buildType: "apk" để ra file .apk, nếu "app-bundle" thì ra file .aab (dùng upload Google Play)

#  build folder android
# npx expo prebuild
# npx expo prebuild --clean


# đây là build ra apk, aab 
# npx expo run:android
# eas build -p android --profile production
# eas build -p android --profile production --clear-cache


#  để test như debug dễ hơn - ít dùng
# eas build -p android --profile development
# eas build -p android --profile development --clear-cache

# ----------------------
# Nếu bạn đang sử dụng Expo mà không có EAS, hãy chạy các lệnh sau:
# For iOS
# npx expo prebuild
# npx expo run:ios

# # For Android
# npx expo prebuild
# npx expo run:android
# --------------------
# Nếu bạn đang sử dụng Expo với EAS, hãy tạo bản dựng mới:
# # For online builds
# npx eas-cli build --profile development

# # For local builds
# npx eas-cli build --profile development --local

